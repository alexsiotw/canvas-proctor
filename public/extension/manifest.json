{
  "manifest_version": 3,
  "name": "Secure Exam Proctor Extension",
  "version": "1.0.0",
  "description": "Enforces advanced browser lockdown and monitoring during proctored Canvas exams.",
  "permissions": [
    "tabs",
    "webNavigation",
    "storage",
    "system.display"
  ],
  "host_permissions": [
    "*://proctor.siotw.net/*",
    "*://canvas.siotw.net/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://proctor.siotw.net/student.html*",
        "*://canvas.siotw.net/courses/*/quizzes/*"
      ],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_icon": "icon.png",
    "default_title": "Secure Exam Proctor"
  }
}
