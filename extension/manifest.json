{
  "manifest_version": 3,
  "name": "ProctorGuard Extension",
  "version": "2.0.0",
  "description": "Enforces advanced browser lockdown and monitoring during proctored Canvas exams.",
  "permissions": [
    "tabs",
    "webNavigation",
    "storage",
    "system.display",
    "browsingData",
    "scripting"
  ],
  "host_permissions": [
    "*://proctor.siotw.net/*",
    "*://canvas.siotw.net/*"
  ],
  "externally_connectable": {
    "matches": ["https://proctor.siotw.net/*"]
  },
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://proctor.siotw.net/student.html*",
        "*://canvas.siotw.net/courses/*/quizzes/*",
        "*://canvas.siotw.net/courses/*/quizzes/*/edit",
        "*://canvas.siotw.net/courses/*/quizzes/new",
        "*://canvas.siotw.net/courses/*/gradebook/speed_grader*"
      ],
      "js": ["content.js"],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "action": {
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    },
    "default_title": "ProctorGuard"
  }
}
